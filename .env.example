# Copy this file to ".env" (same folder) and fill in your values.
# .env is read at startup; values already set in your real environment take priority.
# Full setup guide: README.md -> "PIA over OpenVPN"

# PIA login for "vpn:<region>" routes. This is your normal PIA login, the one you
# use for the PIA app - the username starts with "p".
# Wrap the password in double quotes if it contains #, spaces or quotes.
PIA_VPN_USER=p0000000
PIA_VPN_PASS="your-normal-pia-password"
