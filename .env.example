# Copy this file to ".env" (same folder) and fill in your values.
# .env is read at startup; values already set in your real environment take priority.
# Full setup guide: README.md -> "PIA setup"

# PIA SOCKS5 credentials. These are NOT your normal PIA login!
#   Normal PIA login   ->  username starts with "p" (p1234567)  -> will NOT work here
#   SOCKS credentials  ->  username starts with "x" (x1234567)  -> what you need
#
# To get them:
#   1. Sign in at https://www.privateinternetaccess.com/account/client-control-panel
#   2. Go to Downloads -> VPN Settings -> SOCKS
#   3. Click "Generate" (or "Regenerate") and copy the username and password shown
#
# Wrap the password in double quotes if it contains #, spaces or quotes.
PIA_SOCKS_USER=x0000000
PIA_SOCKS_PASS="your-socks-password"

# PIA OpenVPN login (for "vpn:<region>" routes). This IS your normal PIA login,
# the one you use for the PIA app - username starts with "p".
PIA_VPN_USER=p0000000
PIA_VPN_PASS="your-normal-pia-password"

# Optional - defaults shown. PIA only runs a SOCKS5 proxy in the Netherlands;
# there is no US or other-country host.
# PIA_SOCKS_HOST=proxy-nl.privateinternetaccess.com
# PIA_SOCKS_PORT=1080
